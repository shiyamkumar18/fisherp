# =============================================================================
# FisherP – Docker Environment Variables Template
# =============================================================================
# Copy this file to .env before running any docker-compose command:
#
#   cp .env.docker.example .env
#
# Fill in every CHANGE_ME value before deploying.
# NEVER commit the real .env file to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Django Core
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_ME_generate_a_secure_random_key_at_least_50_chars

# Must be "False" in all production/staging environments
DEBUG=False

# Comma-separated list of hostnames Django will respond to
# Example: api.fisherp.com,fisherp.com,localhost
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DB_NAME=fisherp_prod
DB_USER=fisherp_user
DB_PASSWORD=CHANGE_ME_strong_database_password
DB_HOST=postgres          # Docker Compose service name
DB_PORT=5432
# Set to "0" when routing through PgBouncer (transaction-pooling mode)
DB_CONN_MAX_AGE=600
# Set to "True" to route Django connections through PgBouncer
USE_PGBOUNCER=False

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---------------------------------------------------------------------------
# CORS – comma-separated list of allowed frontend origins
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ---------------------------------------------------------------------------
# JWT token lifetime (minutes)
# ---------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15

# ---------------------------------------------------------------------------
# Email (SMTP)
# ---------------------------------------------------------------------------
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=CHANGE_ME_smtp_password
DEFAULT_FROM_EMAIL=noreply@fisherp.com

# ---------------------------------------------------------------------------
# Sentry error tracking (optional but strongly recommended)
# ---------------------------------------------------------------------------
# SENTRY_DSN=https://your-key@sentry.io/project-id
# SENTRY_TRACES_SAMPLE_RATE=0.05

# ---------------------------------------------------------------------------
# Django Superuser (created on first container start if all three are set)
# ---------------------------------------------------------------------------
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@fisherp.com
# DJANGO_SUPERUSER_PASSWORD=CHANGE_ME_strong_admin_password

# ---------------------------------------------------------------------------
# Production: domain name used in Nginx server_name
# ---------------------------------------------------------------------------
DOMAIN=fisherp.com
