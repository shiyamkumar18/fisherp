# =============================================================================
# FisherP – Docker Environment Variables Template
# =============================================================================
# Copy this file to .env before running any docker-compose command:
#
#   cp .env.docker.example .env
#
# Fill in every CHANGE_ME value before deploying.
# NEVER commit the real .env file to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Django Core
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_ME_generate_a_secure_random_key_at_least_50_chars

# Must be "False" in all production/staging environments
DEBUG=False

# Comma-separated list of hostnames Django will respond to
# Example: api.fisherp.com,fisherp.com
ALLOWED_HOSTS=CHANGE_ME_your_production_hostname

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DB_NAME=fisherp_prod
DB_USER=fisherp_user
DB_PASSWORD=CHANGE_ME_strong_database_password
DB_HOST=postgres          # Docker Compose service name (or pgbouncer when USE_PGBOUNCER=True)
DB_PORT=5432
# Set to "0" when routing through PgBouncer (transaction-pooling mode)
DB_CONN_MAX_AGE=0
# Set to "True" to route Django connections through PgBouncer
USE_PGBOUNCER=True
# Set to "disable" when SSL is terminated at Nginx/load-balancer level
DB_SSLMODE=disable

# ---------------------------------------------------------------------------
# Redis / Celery
# FIX WARNING #9: Redis now requires a password in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ---------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/1

# ---------------------------------------------------------------------------
# CORS – comma-separated list of allowed frontend origins
# Example: https://app.fisherp.com,https://www.fisherp.com
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=CHANGE_ME_https://your-frontend-domain.com

# ---------------------------------------------------------------------------
# JWT token lifetime (minutes)
# ---------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15

# ---------------------------------------------------------------------------
# Email (SMTP)
# FIX WARNING #7: EMAIL_HOST_PASSWORD is required – missing it silently breaks
# all outbound email (password resets, invites, notifications).
# ---------------------------------------------------------------------------
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=CHANGE_ME_smtp_password
DEFAULT_FROM_EMAIL=noreply@fisherp.com

# ---------------------------------------------------------------------------
# Sentry error tracking (FIX WARNING #6: now required – sentry-sdk is installed)
# Create a project at https://sentry.io and paste the DSN here.
# ---------------------------------------------------------------------------
SENTRY_DSN=CHANGE_ME_https://your-key@sentry.io/project-id
SENTRY_TRACES_SAMPLE_RATE=0.05

# ---------------------------------------------------------------------------
# Django Superuser (created on first container start if all three are set)
# Use strong, unique credentials — NOT admin / admin123
# ---------------------------------------------------------------------------
DJANGO_SUPERUSER_USERNAME=CHANGE_ME_admin_username
DJANGO_SUPERUSER_EMAIL=CHANGE_ME_admin@yourdomain.com
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME_strong_admin_password

# ---------------------------------------------------------------------------
# Production: domain name used in Nginx server_name
# ---------------------------------------------------------------------------
DOMAIN=CHANGE_ME_yourdomain.com
