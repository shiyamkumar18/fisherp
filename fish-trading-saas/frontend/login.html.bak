<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FisherP — Sign In</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        /* ── Reset ───────────────────────────────── */
        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
        html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
        img,svg{display:block;max-width:100%}
        button,input,select{font:inherit}
        a{color:inherit;text-decoration:none}

        /* ── Tokens ──────────────────────────────── */
        :root{
            --font:"Manrope",system-ui,-apple-system,sans-serif;
            --teal:#0f766e;--teal-bright:#14b8a6;--teal-dark:#115e59;
            --navy:#102a43;--ink:#1e293b;--muted:#64748b;--subtle:#94a3b8;
            --border:#e2e8f0;--border-focus:var(--teal);
            --bg:#eff8f8;--surface:#fff;--surface-hover:#f8fafa;
            --danger:#dc2626;--danger-bg:#fef2f2;
            --success:#16a34a;--success-bg:#f0fdf4;
            --warning:#f59e0b;--warning-bg:#fffbeb;
            --info:#0284c7;--info-bg:#f0f9ff;
            --shadow-sm:0 1px 2px rgba(15,23,42,.05);
            --shadow-md:0 4px 12px rgba(15,23,42,.08);
            --shadow-lg:0 20px 50px rgba(15,23,42,.12);
            --shadow-xl:0 32px 64px rgba(15,23,42,.18);
            --radius-sm:8px;--radius-md:12px;--radius-lg:16px;--radius-xl:24px;
            --motion:220ms ease;--motion-fast:140ms ease;
        }

        /* ── Page ────────────────────────────────── */
        body{
            font-family:var(--font);
            color:var(--ink);
            min-height:100vh;
            display:flex;
            background:
                radial-gradient(ellipse at 20% 0%,rgba(20,184,166,.14),transparent 50%),
                radial-gradient(ellipse at 80% 100%,rgba(2,132,199,.1),transparent 50%),
                linear-gradient(180deg,#eff8f8 0%,#f6fbfb 50%,#edf4f7 100%);
        }

        /* ── Split layout ────────────────────────── */
        .login-split{display:flex;width:100%;min-height:100vh}

        /* Left brand panel */
        .brand-panel{
            flex:0 0 44%;max-width:560px;
            display:flex;flex-direction:column;
            justify-content:center;align-items:center;
            padding:3rem 2.5rem;
            background:linear-gradient(160deg,#0f766e 0%,#115e59 40%,#102a43 100%);
            color:#fff;position:relative;overflow:hidden;
        }
        .brand-panel::before{
            content:"";position:absolute;inset:0;
            background:
                radial-gradient(circle at 30% 20%,rgba(20,184,166,.35),transparent 50%),
                radial-gradient(circle at 70% 80%,rgba(2,132,199,.2),transparent 50%);
            pointer-events:none;
        }
        .brand-inner{position:relative;z-index:1;text-align:center;max-width:380px}
        .brand-icon{
            width:80px;height:80px;
            background:rgba(255,255,255,.12);
            border:1px solid rgba(255,255,255,.18);
            border-radius:24px;
            display:flex;align-items:center;justify-content:center;
            font-size:2.2rem;margin:0 auto 2rem;
            backdrop-filter:blur(8px);
        }
        .brand-inner h1{font-size:2rem;font-weight:800;letter-spacing:-.02em;margin-bottom:.75rem}
        .brand-inner p{font-size:1rem;line-height:1.7;opacity:.8;margin-bottom:2.5rem}
        .brand-features{list-style:none;text-align:left}
        .brand-features li{
            display:flex;align-items:center;gap:.75rem;
            font-size:.9rem;font-weight:500;opacity:.85;
            padding:.6rem 0;
        }
        .brand-features li i{
            width:28px;height:28px;
            display:flex;align-items:center;justify-content:center;
            background:rgba(255,255,255,.1);border-radius:8px;font-size:.75rem;
        }
        .brand-badge{
            display:inline-flex;align-items:center;gap:.5rem;
            margin-top:2.5rem;padding:.6rem 1.2rem;
            background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);
            border-radius:100px;font-size:.78rem;font-weight:600;
        }

        /* Right form panel */
        .form-panel{
            flex:1;display:flex;flex-direction:column;
            align-items:center;justify-content:center;
            padding:2rem 1.5rem;overflow-y:auto;
        }

        .login-card{
            width:100%;max-width:440px;
            background:var(--surface);
            border:1px solid var(--border);
            border-radius:var(--radius-xl);
            box-shadow:var(--shadow-lg);
            padding:2.5rem 2.25rem;
        }

        /* Mobile brand bar (hidden on desktop) */
        .mobile-brand{display:none;text-align:center;margin-bottom:1.75rem}
        .mobile-brand-icon{
            width:52px;height:52px;
            background:linear-gradient(135deg,var(--teal),var(--teal-bright));
            border-radius:16px;display:inline-flex;align-items:center;justify-content:center;
            color:#fff;font-size:1.5rem;margin-bottom:.75rem;
            box-shadow:0 10px 24px rgba(15,118,110,.3);
        }
        .mobile-brand h2{font-size:1.35rem;font-weight:800;color:var(--navy)}
        .mobile-brand p{font-size:.82rem;color:var(--muted);margin-top:.25rem}

        /* ── Card header ─────────────────────────── */
        .card-header{margin-bottom:1.75rem}
        .card-header h2{font-size:1.4rem;font-weight:800;color:var(--navy);margin-bottom:.35rem}
        .card-header p{font-size:.875rem;color:var(--muted);line-height:1.5}

        /* ── Alert ───────────────────────────────── */
        .alert{
            display:none;align-items:flex-start;gap:.6rem;
            padding:.85rem 1rem;border-radius:var(--radius-md);
            font-size:.82rem;font-weight:500;line-height:1.5;
            margin-bottom:1.25rem;border-left:3px solid transparent;
        }
        .alert.show{display:flex}
        .alert i{margin-top:2px;flex-shrink:0}
        .alert-error{background:var(--danger-bg);color:var(--danger);border-left-color:var(--danger)}
        .alert-success{background:var(--success-bg);color:var(--success);border-left-color:var(--success)}
        .alert-warning{background:var(--warning-bg);color:var(--warning);border-left-color:var(--warning)}
        .alert-info{background:var(--info-bg);color:var(--info);border-left-color:var(--info)}

        /* ── Form fields ─────────────────────────── */
        .field{margin-bottom:1.15rem}
        .field-label{
            display:flex;align-items:center;gap:.4rem;
            font-size:.8rem;font-weight:700;
            color:var(--ink);letter-spacing:.02em;
            text-transform:uppercase;margin-bottom:.45rem;
        }
        .field-label .optional{
            font-size:.7rem;font-weight:500;
            text-transform:none;color:var(--subtle);
        }
        .field-wrap{position:relative}
        .field-icon{
            position:absolute;left:14px;top:50%;transform:translateY(-50%);
            color:var(--subtle);font-size:.88rem;pointer-events:none;
            transition:color var(--motion-fast);
        }
        .field-input{
            width:100%;height:48px;
            padding:0 14px 0 42px;
            background:var(--surface);
            border:1.5px solid var(--border);
            border-radius:var(--radius-md);
            font-size:.92rem;font-weight:500;
            color:var(--ink);
            transition:border-color var(--motion-fast),box-shadow var(--motion-fast);
        }
        .field-input::placeholder{color:var(--subtle);font-weight:400}
        .field-input:hover{border-color:#cbd5e1}
        .field-input:focus{
            outline:none;
            border-color:var(--teal);
            box-shadow:0 0 0 3px rgba(15,118,110,.1);
        }
        .field-input:focus ~ .field-icon{color:var(--teal)}
        .field-input.has-error{border-color:var(--danger);background:var(--danger-bg)}
        .field-input.has-error:focus{box-shadow:0 0 0 3px rgba(220,38,38,.1)}
        .field-input.valid{border-color:var(--success)}
        .field-input.valid ~ .field-icon{color:var(--success)}
        .field-hint{font-size:.72rem;color:var(--subtle);margin-top:.35rem;line-height:1.4}
        .field-error{font-size:.72rem;color:var(--danger);margin-top:.35rem;display:none}
        .field-error.show{display:block}

        /* Input with action button (OTP) */
        .field-action{
            position:absolute;right:6px;top:50%;transform:translateY(-50%);
            height:36px;padding:0 14px;
            background:linear-gradient(135deg,var(--teal),var(--teal-bright));
            color:#fff;border:none;border-radius:var(--radius-sm);
            font-size:.76rem;font-weight:700;
            cursor:pointer;white-space:nowrap;
            transition:opacity var(--motion-fast),transform var(--motion-fast);
        }
        .field-action:hover{opacity:.9;transform:translateY(-50%) scale(1.02)}
        .field-action:disabled{opacity:.5;cursor:not-allowed;transform:translateY(-50%)}
        .field-action.hidden{display:none}
        .field-input.has-action{padding-right:120px}

        /* Password toggle */
        .password-toggle{
            position:absolute;right:14px;top:50%;transform:translateY(-50%);
            background:none;border:none;cursor:pointer;
            color:var(--subtle);font-size:.92rem;padding:4px;
            transition:color var(--motion-fast);
        }
        .password-toggle:hover{color:var(--teal)}

        /* ── Divider ─────────────────────────────── */
        .divider{
            display:flex;align-items:center;gap:.75rem;
            margin:1.25rem 0;color:var(--subtle);font-size:.76rem;font-weight:600;
            text-transform:uppercase;letter-spacing:.06em;
        }
        .divider::before,.divider::after{content:"";flex:1;height:1px;background:var(--border)}

        /* ── OTP section ─────────────────────────── */
        .otp-section{
            display:none;
            padding:1.25rem;
            background:linear-gradient(135deg,rgba(15,118,110,.03),rgba(20,184,166,.05));
            border:1px solid rgba(15,118,110,.1);
            border-radius:var(--radius-md);
            margin-bottom:1.15rem;
        }
        .otp-section.show{display:block;animation:slideDown .3s ease}
        @keyframes slideDown{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:translateY(0)}}
        .otp-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:.85rem}
        .otp-header span{font-size:.82rem;font-weight:700;color:var(--teal-dark)}
        .otp-header button{
            font-size:.72rem;font-weight:600;color:var(--teal);
            background:none;border:none;cursor:pointer;text-decoration:underline;
        }
        .otp-digits{display:flex;gap:8px;justify-content:center;margin-bottom:.85rem}
        .otp-digit{
            width:44px;height:52px;
            text-align:center;font-size:1.25rem;font-weight:700;
            border:1.5px solid var(--border);border-radius:var(--radius-sm);
            background:var(--surface);color:var(--ink);
            transition:border-color var(--motion-fast),box-shadow var(--motion-fast);
        }
        .otp-digit:focus{outline:none;border-color:var(--teal);box-shadow:0 0 0 3px rgba(15,118,110,.12)}
        .otp-digit.filled{border-color:var(--teal);background:rgba(15,118,110,.04)}
        .otp-meta{display:flex;align-items:center;justify-content:space-between;font-size:.72rem}
        .otp-meta span{color:var(--muted)}
        .otp-meta button{
            background:none;border:none;cursor:pointer;
            color:var(--teal);font-weight:700;font-size:.72rem;
        }
        .otp-meta button:disabled{color:var(--subtle);cursor:not-allowed}

        /* ── Form row ────────────────────────────── */
        .form-row{
            display:flex;align-items:center;justify-content:space-between;
            font-size:.82rem;margin-bottom:1.5rem;
        }
        .checkbox-label{
            display:flex;align-items:center;gap:.45rem;
            font-weight:500;color:var(--muted);cursor:pointer;
        }
        .checkbox-label input[type="checkbox"]{
            width:16px;height:16px;cursor:pointer;
            accent-color:var(--teal);
        }
        .forgot-link{color:var(--teal);font-weight:600;transition:color var(--motion-fast)}
        .forgot-link:hover{color:var(--teal-dark);text-decoration:underline}

        /* ── Buttons ─────────────────────────────── */
        .btn-login{
            width:100%;height:52px;
            display:flex;align-items:center;justify-content:center;gap:.6rem;
            background:linear-gradient(135deg,var(--teal),var(--teal-bright));
            color:#fff;border:none;border-radius:var(--radius-lg);
            font-size:.95rem;font-weight:700;
            cursor:pointer;position:relative;overflow:hidden;
            box-shadow:0 12px 28px rgba(15,118,110,.25);
            transition:transform var(--motion-fast),box-shadow var(--motion-fast);
        }
        .btn-login:hover{transform:translateY(-2px);box-shadow:0 16px 36px rgba(15,118,110,.32)}
        .btn-login:active{transform:translateY(0);box-shadow:0 8px 20px rgba(15,118,110,.2)}
        .btn-login:disabled{opacity:.55;cursor:not-allowed;transform:none}
        .btn-login .spinner{
            width:18px;height:18px;
            border:2.5px solid rgba(255,255,255,.3);
            border-top-color:#fff;border-radius:50%;
            animation:spin .7s linear infinite;display:inline-block;
        }
        @keyframes spin{to{transform:rotate(360deg)}}

        /* ── Footer ──────────────────────────────── */
        .card-footer{
            text-align:center;margin-top:1.75rem;
            padding-top:1.25rem;border-top:1px solid var(--border);
        }
        .card-footer p{font-size:.84rem;color:var(--muted)}
        .card-footer a{color:var(--teal);font-weight:700;transition:color var(--motion-fast)}
        .card-footer a:hover{color:var(--teal-dark);text-decoration:underline}

        .legal{
            text-align:center;margin-top:1.5rem;
            font-size:.7rem;color:var(--subtle);line-height:1.5;
        }
        .legal a{color:var(--muted);text-decoration:underline}

        /* ── Phone field detect badge ────────────── */
        .detect-badge{
            display:inline-flex;align-items:center;gap:.3rem;
            font-size:.68rem;font-weight:600;
            padding:2px 8px;border-radius:100px;
            margin-left:auto;
        }
        .detect-badge.phone{background:rgba(15,118,110,.08);color:var(--teal)}

        /* ── Responsive ──────────────────────────── */
        @media(max-width:900px){
            .brand-panel{display:none}
            .mobile-brand{display:block}
            .login-card{
                border:none;box-shadow:none;
                background:transparent;padding:1rem 0;
            }
            .form-panel{padding:1.5rem 1.25rem}
        }

        @media(max-width:420px){
            .otp-digit{width:38px;height:46px;font-size:1.1rem}
            .field-input{height:46px;font-size:.88rem}
            .btn-login{height:48px;font-size:.9rem}
        }

        /* ── Focus visible ───────────────────────── */
        :focus-visible{outline:2px solid var(--teal);outline-offset:2px}
        input:focus-visible{outline:none}
    </style>
</head>
<body>
<div class="login-split">
    <!-- Left: Brand Panel -->
    <div class="brand-panel" role="presentation">
        <div class="brand-inner">
            <div class="brand-icon"><i class="fas fa-fish-fins"></i></div>
            <h1>FisherP</h1>
            <p>The complete trading platform built for fish merchants. Manage purchases, sales, inventory, and payments — all in one place.</p>
            <ul class="brand-features">
                <li><i class="fas fa-bolt"></i> Real-time inventory tracking</li>
                <li><i class="fas fa-chart-line"></i> Daily profit &amp; loss reports</li>
                <li><i class="fas fa-users"></i> Multi-user role based access</li>
                <li><i class="fas fa-shield-halved"></i> Secure OTP &amp; password login</li>
                <li><i class="fas fa-building"></i> Multi-company workspace support</li>
            </ul>
            <div class="brand-badge">
                <i class="fas fa-lock"></i>
                End-to-end encrypted &middot; SOC 2 ready
            </div>
        </div>
    </div>

    <!-- Right: Form Panel -->
    <div class="form-panel">
        <div class="login-card">
            <div class="mobile-brand">
                <div class="mobile-brand-icon"><i class="fas fa-fish-fins"></i></div>
                <h2>FisherP</h2>
                <p>Fish trading made simple</p>
            </div>

            <div class="card-header">
                <h2>Sign in to your account</h2>
                <p>Enter your credentials below to access your workspace</p>
            </div>

            <div id="alert" class="alert" role="alert">
                <i id="alertIcon" class="fas fa-circle-exclamation"></i>
                <span id="alertText"></span>
            </div>

            <form id="loginForm" novalidate autocomplete="on">
                <!-- Company Name -->
                <div class="field">
                    <label class="field-label">
                        <i class="fas fa-building"></i>
                        Company Name
                        <span class="optional">(optional)</span>
                    </label>
                    <div class="field-wrap">
                        <i class="fas fa-building field-icon"></i>
                        <input
                            type="text"
                            id="companyName"
                            class="field-input"
                            placeholder="e.g. Fresh Fish Traders"
                            autocomplete="organization"
                        >
                    </div>
                    <div class="field-hint">Company employees can enter the company name or code to login directly</div>
                </div>

                <!-- Email -->
                <div class="field">
                    <label class="field-label">
                        <i class="fas fa-envelope"></i>
                        Email Address
                    </label>
                    <div class="field-wrap">
                        <i class="fas fa-envelope field-icon"></i>
                        <input
                            type="email"
                            id="email"
                            class="field-input"
                            placeholder="you@company.com"
                            autocomplete="email"
                            inputmode="email"
                        >
                    </div>
                </div>

                <!-- Phone Number -->
                <div class="field">
                    <label class="field-label">
                        <i class="fas fa-phone"></i>
                        Phone Number
                        <span id="phoneDetect" class="detect-badge phone" style="display:none">
                            <i class="fas fa-shield-halved"></i> OTP available
                        </span>
                    </label>
                    <div class="field-wrap">
                        <i class="fas fa-phone field-icon"></i>
                        <input
                            type="tel"
                            id="phone"
                            class="field-input"
                            placeholder="+91 98765 43210"
                            autocomplete="tel"
                            inputmode="tel"
                        >
                        <button
                            type="button"
                            id="sendOtpBtn"
                            class="field-action hidden"
                        >
                            <i class="fas fa-paper-plane"></i>&nbsp; Send OTP
                        </button>
                    </div>
                    <div class="field-hint">Enter your registered phone number to login with OTP</div>
                </div>

                <!-- OTP Section -->
                <div id="otpSection" class="otp-section">
                    <div class="otp-header">
                        <span><i class="fas fa-key"></i>&nbsp; Enter verification code</span>
                        <button type="button" id="cancelOtp">Use password instead</button>
                    </div>
                    <div class="otp-digits" id="otpDigits">
                        <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" autocomplete="one-time-code" aria-label="OTP digit 1">
                        <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" aria-label="OTP digit 2">
                        <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" aria-label="OTP digit 3">
                        <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" aria-label="OTP digit 4">
                        <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" aria-label="OTP digit 5">
                        <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" aria-label="OTP digit 6">
                    </div>
                    <div class="otp-meta">
                        <span id="otpTimer">Expires in 5:00</span>
                        <button type="button" id="resendOtp" disabled>Resend OTP</button>
                    </div>
                </div>

                <!-- Divider -->
                <div class="divider" id="passwordDivider">or continue with password</div>

                <!-- Password -->
                <div class="field" id="passwordField">
                    <label class="field-label">
                        <i class="fas fa-lock"></i>
                        Password
                    </label>
                    <div class="field-wrap">
                        <i class="fas fa-lock field-icon"></i>
                        <input
                            type="password"
                            id="password"
                            class="field-input"
                            placeholder="Enter your password"
                            autocomplete="current-password"
                        >
                        <button
                            type="button"
                            class="password-toggle"
                            id="passwordToggle"
                            aria-label="Show password"
                        >
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>

                <!-- Remember + Forgot -->
                <div class="form-row">
                    <label class="checkbox-label">
                        <input type="checkbox" id="rememberMe">
                        Remember me
                    </label>
                    <a href="#" class="forgot-link" id="forgotLink">Forgot password?</a>
                </div>

                <!-- Submit -->
                <button type="submit" class="btn-login" id="loginBtn">
                    <span id="loginBtnText">Sign In</span>
                </button>
            </form>

            <div class="card-footer">
                <p>Don't have an account? <a href="/register.html">Create your workspace</a></p>
            </div>

            <div class="legal">
                By signing in you agree to our
                <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    'use strict';

    var form          = document.getElementById('loginForm');
    var companyInput  = document.getElementById('companyName');
    var emailInput    = document.getElementById('email');
    var phoneInput    = document.getElementById('phone');
    var passwordInput = document.getElementById('password');
    var loginBtn      = document.getElementById('loginBtn');
    var loginBtnText  = document.getElementById('loginBtnText');
    var passwordToggle= document.getElementById('passwordToggle');
    var passwordField = document.getElementById('passwordField');
    var passwordDivider = document.getElementById('passwordDivider');
    var sendOtpBtn    = document.getElementById('sendOtpBtn');
    var phoneDetect   = document.getElementById('phoneDetect');
    var otpSection    = document.getElementById('otpSection');
    var otpDigits     = document.querySelectorAll('.otp-digit');
    var cancelOtp     = document.getElementById('cancelOtp');
    var resendOtp     = document.getElementById('resendOtp');
    var otpTimer      = document.getElementById('otpTimer');
    var alertEl       = document.getElementById('alert');
    var alertIcon     = document.getElementById('alertIcon');
    var alertText     = document.getElementById('alertText');
    var forgotLink    = document.getElementById('forgotLink');

    var API_BASE = window.location.origin + '/api';
    var loginMode       = 'password';
    var otpSent         = false;
    var resendCountdown = 0;
    var countdownTimer  = null;

    // Redirect if already logged in
    if (localStorage.getItem('token') || localStorage.getItem('access_token')) {
        window.location.href = localStorage.getItem('isPlatformUser') === 'true'
            ? '/platform/dashboard.html'
            : '/dashboard.html';
        return;
    }

    // Restore remember me
    var savedEmail = localStorage.getItem('savedEmail');
    if (savedEmail && localStorage.getItem('rememberMe') === 'true') {
        emailInput.value = savedEmail;
        document.getElementById('rememberMe').checked = true;
    }

    function isValidPhone(v) {
        return /^\+?[0-9][\d\s\-]{6,14}$/.test((v || '').trim());
    }

    function normalizePhone(v) {
        return (v || '').replace(/[^\d]/g, '').slice(-10);
    }

    function showAlert(msg, type) {
        type = type || 'error';
        var icons = {
            error: 'fa-circle-exclamation',
            success: 'fa-circle-check',
            warning: 'fa-triangle-exclamation',
            info: 'fa-circle-info'
        };
        alertIcon.className = 'fas ' + (icons[type] || icons.error);
        alertText.textContent = msg;
        alertEl.className = 'alert alert-' + type + ' show';
    }

    function hideAlert() {
        alertEl.className = 'alert';
    }

    function setLoading(on) {
        loginBtn.disabled = on;
        loginBtnText.innerHTML = on
            ? '<span class="spinner"></span>'
            : 'Sign In';
    }

    function buildIdentifier() {
        var email = (emailInput.value || '').trim();
        var phone = (phoneInput.value || '').trim();
        var company = (companyInput.value || '').trim();
        if (email) return email;
        if (phone) return phone;
        if (company) return company;
        return '';
    }

    // Phone detection: show Send OTP button
    phoneInput.addEventListener('input', function () {
        var val = phoneInput.value.trim();
        if (isValidPhone(val)) {
            sendOtpBtn.classList.remove('hidden');
            phoneInput.classList.add('has-action');
            phoneDetect.style.display = 'inline-flex';
        } else {
            sendOtpBtn.classList.add('hidden');
            phoneInput.classList.remove('has-action');
            phoneDetect.style.display = 'none';
            if (otpSent) { resetOtp(); }
        }
    });

    // Password toggle
    passwordToggle.addEventListener('click', function () {
        var isPassword = passwordInput.type === 'password';
        passwordInput.type = isPassword ? 'text' : 'password';
        passwordToggle.innerHTML = isPassword
            ? '<i class="fas fa-eye-slash"></i>'
            : '<i class="fas fa-eye"></i>';
        passwordToggle.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
    });

    // Send OTP
    sendOtpBtn.addEventListener('click', async function () {
        hideAlert();
        var phone = normalizePhone(phoneInput.value);

        if (phone.length < 10) {
            showAlert('Enter a valid 10-digit phone number.', 'error');
            phoneInput.focus();
            return;
        }

        sendOtpBtn.disabled = true;
        sendOtpBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>&nbsp; Sending...';

        try {
            var res = await fetch(API_BASE + '/send-otp/', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ phone: phone, purpose: 'login' })
            });

            var data = await res.json();

            if (!res.ok) {
                showAlert(data.error || data.detail || 'Unable to send OTP.', 'error');
                return;
            }

            otpSent = true;
            loginMode = 'otp';
            otpSection.classList.add('show');
            passwordField.style.display = 'none';
            passwordDivider.style.display = 'none';
            otpDigits[0].focus();
            startCountdown(60);
            showAlert('OTP sent to ' + phone.slice(-4).padStart(phone.length, '\u2022'), 'success');
        } catch (err) {
            console.error('Send OTP error:', err);
            showAlert('Connection failed. Please try again.', 'error');
        } finally {
            sendOtpBtn.disabled = false;
            sendOtpBtn.innerHTML = '<i class="fas fa-paper-plane"></i>&nbsp; Send OTP';
        }
    });

    // Cancel OTP
    cancelOtp.addEventListener('click', function () {
        resetOtp();
        passwordInput.focus();
    });

    function resetOtp() {
        otpSent = false;
        loginMode = 'password';
        otpSection.classList.remove('show');
        passwordField.style.display = '';
        passwordDivider.style.display = '';
        clearOtpDigits();
        stopCountdown();
    }

    // OTP digit inputs
    otpDigits.forEach(function (digit, idx) {
        digit.addEventListener('input', function () {
            digit.value = digit.value.replace(/\D/g, '');
            digit.classList.toggle('filled', digit.value !== '');
            if (digit.value && idx < otpDigits.length - 1) {
                otpDigits[idx + 1].focus();
            }
            if (getOtpValue().length === 6) {
                form.dispatchEvent(new Event('submit', { cancelable: true }));
            }
        });
        digit.addEventListener('keydown', function (e) {
            if (e.key === 'Backspace' && !digit.value && idx > 0) {
                otpDigits[idx - 1].focus();
            }
        });
        digit.addEventListener('paste', function (e) {
            e.preventDefault();
            var paste = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '');
            for (var i = 0; i < otpDigits.length && i < paste.length; i++) {
                otpDigits[i].value = paste[i];
                otpDigits[i].classList.add('filled');
            }
            var focusIdx = Math.min(paste.length, otpDigits.length - 1);
            otpDigits[focusIdx].focus();
            if (paste.length >= 6) {
                form.dispatchEvent(new Event('submit', { cancelable: true }));
            }
        });
    });

    function getOtpValue() {
        return Array.from(otpDigits).map(function (d) { return d.value; }).join('');
    }

    function clearOtpDigits() {
        otpDigits.forEach(function (d) {
            d.value = '';
            d.classList.remove('filled');
        });
    }

    // Resend OTP
    resendOtp.addEventListener('click', function () {
        sendOtpBtn.click();
    });

    // Countdown
    function startCountdown(seconds) {
        stopCountdown();
        resendCountdown = seconds;
        resendOtp.disabled = true;
        updateTimerDisplay();
        countdownTimer = setInterval(function () {
            resendCountdown--;
            updateTimerDisplay();
            if (resendCountdown <= 0) {
                stopCountdown();
                resendOtp.disabled = false;
                resendOtp.textContent = 'Resend OTP';
                otpTimer.textContent = 'Code expired';
            }
        }, 1000);
    }

    function stopCountdown() {
        if (countdownTimer) {
            clearInterval(countdownTimer);
            countdownTimer = null;
        }
    }

    function updateTimerDisplay() {
        var m = Math.floor(resendCountdown / 60);
        var s = resendCountdown % 60;
        otpTimer.textContent = 'Expires in ' + m + ':' + (s < 10 ? '0' : '') + s;
        resendOtp.textContent = 'Resend (' + resendCountdown + 's)';
    }

    // Forgot password
    forgotLink.addEventListener('click', function (e) {
        e.preventDefault();
        showAlert('Password reset link will be sent to your email. Feature coming soon.', 'info');
    });

    // Form Submit
    form.addEventListener('submit', async function (e) {
        e.preventDefault();
        hideAlert();

        var identifier = buildIdentifier();
        if (!identifier) {
            showAlert('Please enter your email, phone, or company name.', 'error');
            emailInput.focus();
            return;
        }

        setLoading(true);

        try {
            if (loginMode === 'otp') {
                var otp = getOtpValue();
                if (otp.length !== 6) {
                    showAlert('Enter the complete 6-digit OTP.', 'error');
                    otpDigits[0].focus();
                    setLoading(false);
                    return;
                }

                var phone = normalizePhone(phoneInput.value);
                var res = await fetch(API_BASE + '/verify-otp/', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ phone: phone, otp: otp }),
                    credentials: 'include'
                });

                var data = await res.json();

                if (!res.ok) {
                    showAlert(data.error || data.detail || 'OTP verification failed.', 'error');
                    clearOtpDigits();
                    otpDigits[0].focus();
                    setLoading(false);
                    return;
                }

                if (data.user_exists === false) {
                    showAlert('Phone verified! No account found. Please register first.', 'warning');
                    setLoading(false);
                    return;
                }

                handleSuccess(data);
            } else {
                var password = passwordInput.value;
                if (!password) {
                    showAlert('Please enter your password.', 'error');
                    passwordInput.focus();
                    setLoading(false);
                    return;
                }

                var res2 = await fetch(API_BASE + '/login/', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ identifier: identifier, password: password }),
                    credentials: 'include'
                });

                var data2 = await res2.json();

                if (!res2.ok) {
                    var errMsg = data2.error || data2.detail || data2.message || 'Invalid credentials.';
                    if (isValidPhone(phoneInput.value) && res2.status === 401) {
                        errMsg += ' You can also try logging in with OTP.';
                    }
                    showAlert(errMsg, 'error');
                    setLoading(false);
                    return;
                }

                handleSuccess(data2);
            }
        } catch (err) {
            console.error('Login error:', err);
            showAlert('Unable to connect. Please check your connection.', 'error');
            setLoading(false);
        }
    });

    function handleSuccess(data) {
        if (document.getElementById('rememberMe').checked) {
            localStorage.setItem('savedEmail', emailInput.value.trim());
            localStorage.setItem('rememberMe', 'true');
        } else {
            localStorage.removeItem('savedEmail');
            localStorage.removeItem('rememberMe');
        }

        var accessToken = data.access || data.token;
        var refreshToken = data.refresh;
        localStorage.setItem('token', accessToken);
        localStorage.setItem('access_token', accessToken);
        if (refreshToken) localStorage.setItem('refresh_token', refreshToken);

        var user = data.user || data;
        localStorage.setItem('username', user.username || '');
        localStorage.setItem('user_id', user.id || '');
        localStorage.setItem('userRole', user.role || 'tenant_admin');
        localStorage.setItem('role', user.role || 'tenant_admin');

        var isPlatform = Boolean(
            user.is_platform_user ||
            user.is_platform_operator ||
            user.is_platform_support ||
            ['platform_operator','platform_support','platform_maintainer','platform_super_admin'].includes(user.role)
        );
        localStorage.setItem('isPlatformUser', isPlatform ? 'true' : 'false');

        if (user.two_factor_enabled) localStorage.setItem('two_factor_enabled', '1');
        else localStorage.setItem('two_factor_enabled', '0');

        if (user.company) {
            localStorage.setItem('company_name', user.company.name || '');
            localStorage.setItem('company_id', user.company.id || '');
            localStorage.setItem('company_slug', user.company.slug || '');
            if (user.company.slug) localStorage.setItem('tenant_slug', user.company.slug);
        }
        if (companyInput.value.trim()) {
            localStorage.setItem('company_name', companyInput.value.trim());
        }

        showAlert('Welcome back! Redirecting...', 'success');
        var redirectUrl = isPlatform ? '/platform/dashboard.html' : '/dashboard.html';
        setTimeout(function () { window.location.href = redirectUrl; }, 400);
    }
})();
</script>
</body>
</html>
