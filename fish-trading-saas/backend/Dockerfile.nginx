# =============================================================================
# FisherP – Nginx Reverse Proxy Dockerfile
# Lightweight Nginx image with custom production configuration
#
# Build from the fish-trading-saas/ directory so both nginx/ config files
# and backend/ are accessible:
#   docker build -f backend/Dockerfile.nginx -t fisherp-nginx ./fish-trading-saas
# =============================================================================

FROM nginx:1.27-alpine

# Remove the default Nginx configuration
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom Nginx configuration files
# Build context must be fish-trading-saas/ so nginx/ is accessible
COPY nginx/nginx.conf /etc/nginx/nginx.conf
COPY nginx/ssl.conf /etc/nginx/conf.d/ssl.conf
COPY nginx/proxy_params.conf /etc/nginx/conf.d/proxy_params.conf

# Create directories for SSL certificates and static/media files
RUN mkdir -p /etc/nginx/ssl \
             /var/www/static \
             /var/www/media

# Non-root: Nginx master process still needs root to bind port 80/443,
# but worker processes run as the 'nginx' user (default in official image).

EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost/health/ > /dev/null 2>&1 || exit 1

CMD ["nginx", "-g", "daemon off;"]
