# =============================================================================
# FisherP – Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Django Core
# ---------------------------------------------------------------------------
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_ME_generate_a_secure_random_key

# Set to False in all production environments
DEBUG=False

# Comma-separated list of hostnames that Django will serve
# e.g. ALLOWED_HOSTS=api.fisherp.com,fisherp.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Database (PostgreSQL – required in production)
# ---------------------------------------------------------------------------
DB_NAME=fisherp_prod
DB_USER=fisherp_user
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_HOST=localhost
DB_PORT=5432
# "require" enforces SSL on the DB connection; use "disable" only for local dev
DB_SSLMODE=require

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# CORS – comma-separated list of allowed frontend origins
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://app.fisherp.com,https://fisherp.com

# ---------------------------------------------------------------------------
# JWT token lifetime (minutes). Default: 15
# ---------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15

# ---------------------------------------------------------------------------
# Email (SMTP – production)
# ---------------------------------------------------------------------------
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=CHANGE_ME_sendgrid_api_key
DEFAULT_FROM_EMAIL=noreply@fisherp.com
SERVER_EMAIL=errors@fisherp.com

# ---------------------------------------------------------------------------
# Sentry error tracking (optional)
# ---------------------------------------------------------------------------
# SENTRY_DSN=https://your-key@sentry.io/project-id
# SENTRY_TRACES_SAMPLE_RATE=0.05
