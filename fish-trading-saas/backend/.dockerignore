# Docker build context exclusions for fish-trading-saas/backend/
# Applies when docker build context is ./fish-trading-saas/backend

# Git
.git
.gitignore
.gitattributes

# Python byte-code & caches
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.Python

# Virtual environments
venv/
.venv/
env/
ENV/

# Test & coverage artifacts
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
*.egg-info/
dist/
build/

# IDE / editor metadata
.vscode/
.idea/
*.swp
*.swo
*.DS_Store
Thumbs.db

# Environment files (secrets must NOT be baked into the image)
.env
.env.*
!.env.example

# SQLite development databases
*.sqlite3
db.sqlite3

# Logs
logs/
*.log

# Static / media collected locally (re-generated at container startup)
staticfiles/
media/

# Documentation that is not needed at runtime
*.md
docs/

# CI/CD configuration
.github/
.circleci/

# Docker files themselves (avoid recursive context)
Dockerfile*
docker-compose*.yml
.dockerignore
