[flake8]
max-line-length = 120
max-complexity = 20
exclude =
    .git,
    __pycache__,
    venv,
    .venv,
    migrations,
    *.egg-info,
    dist,
    build,
    staticfiles,
    .tox
ignore =
    E501,
    W503,
    W504,
    E302,
    E303,
    W291,
    W293
statistics = True
count = True
show-source = True
