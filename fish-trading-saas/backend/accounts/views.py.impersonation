from rest_framework.views import APIView
from rest_framework.response import Response
from rest_framework import status
from django.contrib.auth import get_user_model
from companies.models import Company
from .permissions import CanUseImpersonation, LoginThrottle, ImpersonationThrottle, is_impersonating, get_impersonated_tenant, start_impersonation, end_impersonation

User = get_user_model()

class ImpersonationAPIView(APIView):
    permission_classes = [ImpersonationThrottle, CanUseImpersonation]

    def post(self, request):
        action = request.data.get('action')
        company_id = request.data.get('company_id')
        reason = request.data.get('reason', '')

        if action == 'start':
            if not company_id:
                return Response({'error': 'company_id required'}, status=status.HTTP_400_BAD_REQUEST)
            try:
                company = Company.objects.get(id=company_id)
                log = start_impersonation(request, company, reason)
                return Response({
                    'status': 'started',
                    'company': {'id': company.id, 'name': company.name, 'slug': company.slug},
                    'log_id': log.id,
                    'expires_at': log.expires_at.isoformat() if log.expires_at else None
                })
            except Company.DoesNotExist:
                return Response({'error': 'Company not found'}, status=status.HTTP_404_NOT_FOUND)

        elif action == 'end':
            success = end_impersonation(request)
            return Response({'status': 'ended'} if success else {'error': 'No active impersonation'})

        else:
            return Response({'error': 'action must be "start" or "end"'}, status=status.HTTP_400_BAD_REQUEST)

    def get(self, request):
        if is_impersonating(request):
            company = get_impersonated_tenant(request)
            return Response({
                'active': True,
                'company': {'id': company.id, 'name': company.name} if company else None
            })
        return Response({'active': False})
