{
  "mcpServers": {
    "fisherp-filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/media/odoo/5AAA-AC72/project/fisherp"
      ]
    },
    "fisherp-postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "${POSTGRES_MCP_URL}"
      ]
    },
    "fisherp-github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PAT}"
      }
    },
    "fisherp-puppeteer": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ]
    },
    "fisherp-docker": {
      "command": "npx",
      "args": [
        "-y",
        "@docker/mcp-server"
      ]
    },
    "fisherp-snyk": {
      "command": "npx",
      "args": [
        "-y",
        "@snyk/mcp-server"
      ],
      "env": {
        "SNYK_TOKEN": "${SNYK_TOKEN}"
      }
    },
    "fisherp-redis": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-redis"
      ],
      "env": {
        "REDIS_URL": "${REDIS_MCP_URL}"
      }
    }
  }
}
